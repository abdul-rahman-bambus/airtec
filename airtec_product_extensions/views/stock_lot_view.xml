<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_lot_form_airtec" model="ir.ui.view">
        <field name="name">stock.lot.form.airtec</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="AIRTEC">
                    <field name="code_payload"/>
                    <field name="code_device"/>
                    <field name="manufacturing_date"/>
                </group>
                <notebook>
                    <page string="Maintenance">
                        <group>
                            <group string="Maintenance Window 1">
                                <field name="maintenance_1_start_date"/>
                                <field name="maintenance_1_end_date"/>
                            </group>
                            <group string="Maintenance Window 2">
                                <field name="maintenance_2_start_date"/>
                                <field name="maintenance_2_end_date"/>
                            </group>
                        </group>
                    </page>
                    <page string="Codes" invisible="not code_device">
                        <group>
                            <group>
                                <field name="code_1"/>
                                <field name="code_date_1"/>
                                <field name="code_2"/>
                                <field name="code_date_2"/>
                            </group>
                            <group>
                                <field name="code_3"/>
                                <field name="code_date_3"/>
                                <field name="code_4"/>
                                <field name="code_date_4"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
