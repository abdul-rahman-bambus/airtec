<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_repair_automation" model="ir.ui.view">
        <field name="name">sale.order.form.repair.automation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="is_maintanance_order"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Repairs">
                    <field name="repair_order_ids" readonly="1"/>
                </page>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id' or @name='product_template_id']" position="after">
                <field name="serial_id" column_invisible="parent.is_maintanance_order == False"/>
                <field name="is_repair_line" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_template_form_repair_automation" model="ir.ui.view">
        <field name="name">sale.order.template.form.repair.automation</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" search="[('model','=','sale.order.template'),('type','=','form')]"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Maintenance Automation">
                    <field name="is_maintanance_quotation"/>
                    <field name="maintanance_1"/>
                    <field name="maintanance_2"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
