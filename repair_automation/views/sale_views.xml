<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_repair_automation" model="ir.ui.view">
        <field name="name">sale.order.form.repair.automation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="is_maintanance_order"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Repairs">
                    <field name="repair_order_ids" readonly="1"/>
                </page>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="after">
                <field name="serial_id" optional="show" column_invisible="parent.is_maintanance_order == False"/>
                <field name="is_repair_line" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_repair_automation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.repair.automation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[contains(@name, 'sale')]" position="inside">
                <block title="Repair Automation" name="repair_automation_settings_block">
                    <setting string="Maintenance Quotation Template" id="maintanance_quotation_template_setting"
                             help="Template used by maintenance cron while creating maintenance quotations.">
                        <field name="maintanance_quotation_template_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
