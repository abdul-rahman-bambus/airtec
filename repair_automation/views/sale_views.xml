<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_repair_automation" model="ir.ui.view">
        <field name="name">sale.order.form.repair.automation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Repairs">
                    <field name="repair_order_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_order_line_tree_repair_automation" model="ir.ui.view">
        <field name="name">sale.order.line.tree.repair.automation</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="serial_id" optional="show"/>
                <field name="is_repair_line" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_line_repair_automation" model="ir.ui.view">
        <field name="name">sale.order.form.line.repair.automation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//tree//field[@name='product_id']" position="after">
                <field name="serial_id"/>
                <field name="is_repair_line" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
